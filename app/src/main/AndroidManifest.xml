<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      应用内更新：App 自己把新 APK 下到 cacheDir，再拉起系统安装页。
      没有这个权限，Android 8 之后安装页根本弹不出来（会被当成恶意行为拦掉）。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      关掉系统自动备份。

      这个项目对隐私是有意识设计的：WebDAV 密码刻意不写进备份 JSON，
      App 平时完全不联网。但账单数据库本身是极私密的东西（每一笔花销、
      商户、账户余额都在里面），而 allowBackup=true 会让它进 Google 云备份
      和换机迁移 —— 等于把正文交出去了，密码不交反而不一致。

      备份由 App 自己的 WebDAV 负责，用户自己控制服务器，不经过 Google。
    -->
    <application
        android:name=".OnlyMoneyNoteApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.OnlyMoneyNote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OnlyMoneyNote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 从微信/支付宝/相册分享截图进来，自动识别记账 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 桌面小组件：今日收支 / 本月结余 / 最近账单 / 快速记一笔 -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today" />
        </receiver>
        <receiver
            android:name=".widget.MonthWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month" />
        </receiver>
        <receiver
            android:name=".widget.RecentWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_recent">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recent" />
        </receiver>
        <receiver
            android:name=".widget.DonutWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_donut">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_donut" />
        </receiver>
        <receiver
            android:name=".widget.QuickAddWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_add">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_add" />
        </receiver>

        <!--
          应用内更新用的 FileProvider：新 APK 下到 cacheDir/update 之后，
          不能直接用 file:// 交给安装器（Android 7 起会抛 FileUriExposedException），
          必须换成 content:// 并临时授权给安装页。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updatefile"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>
